rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Yardımcı fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdfFile() {
      return request.resource.contentType == 'application/pdf';
    }

    function isAudioFile() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isAllowedFileType() {
      return isImageFile() || isPdfFile() || isAudioFile()
        || request.resource.contentType.matches('application/vnd.openxmlformats.*') // xlsx, docx
        || request.resource.contentType == 'application/vnd.ms-excel';
    }

    // Max 50MB dosya boyutu
    function isValidFileSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }

    // ─── Sosyal Medya Gönderileri ─────────────────────────────────
    match /social_posts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && isAllowedFileType()
        && isValidFileSize();
    }

    // ─── Sınav Kitapçıkları ───────────────────────────────────────
    match /exam_booklets/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isPdfFile() || isImageFile())
        && (request.resource == null || isValidFileSize());
    }

    // ─── Ödev Ekleri ──────────────────────────────────────────────
    match /homeworks/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && isAllowedFileType()
        && isValidFileSize();
    }

    // ─── Okul Logoları / Profil Fotoğrafları ─────────────────────
    match /school_assets/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && isImageFile()
        && request.resource.size < 5 * 1024 * 1024; // Max 5MB
    }

    // ─── PDF Raporlar ─────────────────────────────────────────────
    match /reports/{allPaths=**} {
      allow read: if isAuthenticated(); // paylaşım linkleri indirme token'ı ile çalışır
      allow write: if isAuthenticated()
        && isPdfFile()
        && isValidFileSize();
    }

    match /shared_reports/{allPaths=**} {
      allow read: if isAuthenticated(); // paylaşım linkleri indirme token'ı ile çalışır
      allow write: if isAuthenticated()
        && isPdfFile()
        && isValidFileSize();
    }

    // ─── Ses Kayıtları ────────────────────────────────────────────
    match /audio_recordings/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && isAudioFile()
        && request.resource.size < 100 * 1024 * 1024; // Max 100MB
    }

    // ─── Ders notları (akıllı tahta): lesson_notes/{kurum}/{öğretmen}/{not}/... ───
    match /lesson_notes/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isPdfFile() || isImageFile())
        && (request.resource == null || isValidFileSize());
    }

    // ─── Deneme Sınavı Optik Dosyaları (TXT/DAT) ─────────────────
    match /trial_exams/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null
            || (request.resource.contentType.matches('text/.*')
                || request.resource.contentType == 'application/octet-stream'))
        && (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }

    // ─── Mağaza Ürün Görselleri ───────────────────────────────────
    match /store_products/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isImageFile())
        && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    // ─── Kantin Ürün Görselleri ───────────────────────────────────
    match /canteen_products/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isImageFile())
        && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    // ─── Genel Merkez Deneme Raporları & Kitapçıkları ─────────────
    match /central_exams/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isPdfFile() || isImageFile())
        && (request.resource == null || isValidFileSize());
    }

    // ─── Fokus Kitap (Kişiye Özel Soru Bankası) Dosyaları ─────────
    match /personalized_books/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (request.resource == null || isPdfFile() || isImageFile())
        && (request.resource == null || isValidFileSize());
    }

    // ─── Default: Her şeyi reddet ─────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
